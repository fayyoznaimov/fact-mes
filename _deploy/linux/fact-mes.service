[Unit]
Description=FACT MES web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fact-mes
Group=fact-mes
WorkingDirectory=/opt/fact-mes/current/_app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Tashkent
EnvironmentFile=/etc/fact-mes/service.env
ExecStart=/usr/bin/python3 -u app.py --host ${MES_HOST} --port ${MES_PORT} $MES_SOURCE_ARGS
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fact-mes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
